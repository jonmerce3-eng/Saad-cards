    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const printB64 = $input.item.json.print_file_b64;\nconst proofB64 = $input.item.json.proof_file_b64;\nconst originalName = $input.item.json.filename || 'Job.pdf';\nconst baseName = originalName.replace(/\\.pdf$/i, '');\n\nreturn {\n  json: {\n    status: $input.item.json.status,\n    job_name: baseName,\n    pages_imposed: $input.item.json.pages_imposed,\n    sheet_size: $input.item.json.sheet_size,\n    chat_id: $('1. Telegram Trigger').item.json.message?.chat?.id || $('1. Telegram Trigger').item.json.callback_query?.message?.chat?.id\n  },\n  binary: {\n    print_pdf: await this.helpers.prepareBinaryData(\n      Buffer.from(printB64, 'base64'),\n      `${baseName}_PRINT_CMYK.pdf`,\n      'application/pdf'\n    ),\n    proof_pdf: await this.helpers.prepareBinaryData(\n      Buffer.from(proofB64, 'base64'),\n      `${baseName}_CLIENT_PROOF.pdf`,\n      'application/pdf'\n    )\n  }\n};"
      },

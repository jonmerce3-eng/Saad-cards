# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Optional. Set this on Render / Koyeb / Railway so the Telegram Bot
# connects automatically on server startup without needing to paste it in the web UI.
TELEGRAM_BOT_TOKEN=""
